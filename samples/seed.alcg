# ALCG v0.1 sample expressions. Each non-comment line is one expression.
DO(actor=AI, action=CREATE, object=LANGUAGE)
DO(actor=PERSON, action=LEARN, object=LANGUAGE)
IS(subject=WATER, property=LIQUID)
HAS(owner=PERSON, item=TOOL)
CAUSE(source=HEAT, effect=CHANGE(subject=WATER, property=TEMPERATURE))
IF(test=RAIN, then=FLOW(subject=WATER))
NOT(claim=IS(subject=FIRE, property=COLD))
COMPARE(left=VALUE_A, right=VALUE_B, by=GREATER_THAN)
KNOW(agent=AI, content=IS(subject=EARTH, property=PLANET))
WANT(agent=PERSON, goal=DO(actor=AI, action=HELP, object=PERSON))
REL(subject=MARKET, relation=EXCHANGE, object=VALUE)
AND(left=IS(subject=WATER, property=LIQUID), right=IS(subject=EARTH, property=PLANET))
RAW(text="An English meaning not yet encoded as a structured concept.")
