{"id":"K01","domain":"daily","target":"A person helps a community.","correct":"DO(actor=PERSON, action=HELP, object=COMMUNITY)","foil":"DO(actor=COMMUNITY, action=HELP, object=PERSON)","contrast":"role_reversal","note":"Reverse who helps whom; lexical labels stay identical."}
{"id":"K02","domain":"daily","target":"A child wants to have food.","correct":"WANT(agent=CHILD, goal=HAS(owner=CHILD, item=FOOD))","foil":"HAS(owner=CHILD, item=FOOD)","contrast":"desire_vs_fact","note":"Wanting to have food does not assert possession."}
{"id":"K03","domain":"science","target":"Rain causes a river to flow.","correct":"CAUSE(source=RAIN, effect=FLOW(subject=RIVER))","foil":"CAUSE(source=FLOW(subject=RIVER), effect=RAIN)","contrast":"causal_direction","note":"The proposed cause/effect roles are reversed."}
{"id":"K04","domain":"science","target":"Earth is not a planet.","correct":"NOT(claim=IS(subject=EARTH, property=PLANET))","foil":"IS(subject=EARTH, property=PLANET)","contrast":"negation_scope","note":"This is a semantic probe, not an endorsement of the false factual claim."}
{"id":"K05","domain":"mathematics","target":"Two is greater than one.","correct":"COMPARE(left=TWO, right=ONE, by=GREATER_THAN)","foil":"COMPARE(left=ONE, right=TWO, by=GREATER_THAN)","contrast":"comparison_direction","note":"Ordering of comparison arguments matters."}
{"id":"K06","domain":"mathematics","target":"Value A equals value B.","correct":"COMPARE(left=VALUE_A, right=VALUE_B, by=EQUAL)","foil":"COMPARE(left=VALUE_A, right=VALUE_B, by=GREATER_THAN)","contrast":"relation_identity","note":"Equality and strict greater-than are distinct relations."}
{"id":"K07","domain":"computing","target":"A program reads data.","correct":"DO(actor=PROGRAM, action=READ, object=DATA)","foil":"DO(actor=PROGRAM, action=WRITE, object=DATA)","contrast":"action_identity","note":"Read and write are distinct actions."}
{"id":"K08","domain":"computing","target":"If a program reads a file, it writes an output.","correct":"IF(test=DO(actor=PROGRAM, action=READ, object=FILE), then=DO(actor=PROGRAM, action=WRITE, object=OUTPUT))","foil":"AND(left=DO(actor=PROGRAM, action=READ, object=FILE), right=DO(actor=PROGRAM, action=WRITE, object=OUTPUT))","contrast":"conditional_vs_conjunction","note":"A conditional does not itself assert both its clauses."}
{"id":"K09","domain":"society","target":"A government has a policy.","correct":"HAS(owner=GOVERNMENT, item=POLICY)","foil":"HAS(owner=POLICY, item=GOVERNMENT)","contrast":"possession_direction","note":"Owner/item roles are not interchangeable."}
{"id":"K10","domain":"society","target":"A person wants rules to be fair.","correct":"WANT(agent=PERSON, goal=IS(subject=RULES, property=FAIR))","foil":"IS(subject=RULES, property=FAIR)","contrast":"desire_vs_fact","note":"Wanting fair rules is not an assertion that the rules are fair."}
{"id":"K11","domain":"epistemic","target":"An agent believes a claim.","correct":"BELIEVE(agent=AGENT, content=CLAIM)","foil":"KNOW(agent=AGENT, content=CLAIM)","contrast":"epistemic_operator","note":"Belief does not entail knowledge."}
{"id":"K12","domain":"epistemic","target":"A claim is not true.","correct":"NOT(claim=IS(subject=CLAIM, property=TRUE))","foil":"IS(subject=CLAIM, property=TRUE)","contrast":"negation_scope","note":"Polarity changes while topic identifiers remain the same."}
